# 複製此檔為 .env.local 後修改即可切換開發後端（.env.local 不會進 Git）
# cp .env.example .env.local
#
# 注意：Vite 載入優先順序為
#   .env.development.local > .env.development > .env.local > .env
# 因此請勿在 .env.development 設定 VITE_BACKEND_HOST，否則會蓋過 .env.local。
#
# 亦可臨時覆寫：
#   VITE_BACKEND_HOST=http://192.168.0.100:7025 npm run dev

VITE_BACKEND_HOST=http://127.0.0.1:7025

